{
  "id": "translink",
  "title": "Fleet Sheet",
  "description": "See which TransLink vehicles are out, where a route is bunched, and what changed since the previous capture.",
  "category": "places",
  "tags": [
    "TransLink",
    "Vancouver",
    "bus",
    "SkyTrain",
    "realtime",
    "bunching"
  ],
  "icon": "route",
  "url": "/translink/",
  "source": "https://github.com/jsdyer/translink",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "TransLink’s GTFS-Realtime feeds supply vehicle positions, trip delays and service alerts for each saved capture.",
    "cadence": "Hourly",
    "probes": [
      {
        "label": "Fleet captured",
        "url": "https://coolcode.ca/translink/data/status.json",
        "path": [
          "captured"
        ],
        "count_at": {
          "path": [
            "buses"
          ],
          "unit": "buses out"
        },
        "precision": "minute"
      },
      {
        "label": "Network",
        "url": "https://coolcode.ca/translink/data/network-status.json",
        "path": [
          "retrieved"
        ]
      }
    ]
  }
